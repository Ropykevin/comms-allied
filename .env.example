# Copy to .env and fill in real values. NEVER commit .env: it holds secrets.
# Provider credentials are read only by the server; they are never sent to the browser.
# Keep comments on their own lines (some .env parsers treat trailing text as part of the value).

# ---- Core -----------------------------------------------------------------------
# development | production (docker-compose forces production)
APP_ENV=development
# REQUIRED in production (the app refuses to start without a random value of 32+ characters).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Public URL used in email links, e.g. https://comms.alliedtours.co.ke
APP_BASE_URL=http://localhost:5000
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_PHONE_REGION=KE
LOG_LEVEL=INFO
# true when served over HTTPS (docker-compose forces true)
SESSION_COOKIE_SECURE=false
# Number of reverse proxies in front of the app (docker-compose sets 1 for Nginx)
TRUSTED_PROXY_COUNT=0

# ---- Database -------------------------------------------------------------------
# Used for local development; docker-compose builds DATABASE_URL from the POSTGRES_* values.
DATABASE_URL=postgresql://allied:change-me@localhost:5432/allied
POSTGRES_DB=allied
POSTGRES_USER=allied
# Use letters/digits only, or URL-encode special characters
POSTGRES_PASSWORD=change-me

# ---- Background jobs ------------------------------------------------------------
# celery (production) | thread (simple local development, no Redis needed)
TASK_BACKEND=thread
REDIS_URL=redis://localhost:6379/0
# memory:// for development; docker-compose uses redis://redis:6379/1
RATELIMIT_STORAGE_URI=memory://
CAMPAIGN_BATCH_SIZE=100
MESSAGE_MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5

# ---- First super admin (used by `flask seed`) ----------------------------------
ADMIN_EMAIL=admin@alliedtours.co.ke
# Leave empty to be prompted interactively
ADMIN_PASSWORD=

# ---- Email (SMTP) ---------------------------------------------------------------
# console (logs only) | smtp
MAIL_PROVIDER=console
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=Allied Tours & Travel <no-reply@alliedtours.co.ke>
# HMAC secret for signed delivery/inbound events posted to /webhooks/email
EMAIL_WEBHOOK_SECRET=replace-with-a-random-secret

# ---- SMS (Africa's Talking) -----------------------------------------------------
# console | africastalking
SMS_PROVIDER=console
SMS_API_KEY=your-sms-api-key
SMS_USERNAME=your-sms-username
SMS_SENDER_ID=
# Appended as ?token=... to the callback URLs registered with the SMS provider
SMS_WEBHOOK_TOKEN=replace-with-a-random-token

# ---- WhatsApp (official Meta WhatsApp Business Cloud API only) -------------------
# console | meta
WHATSAPP_PROVIDER=console
WHATSAPP_API_KEY=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0
# Verifies the X-Hub-Signature-256 header on incoming webhooks
WHATSAPP_APP_SECRET=your-meta-app-secret
# Entered once in the Meta dashboard when registering the webhook
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-token

# ---- Gunicorn (optional) --------------------------------------------------------
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60
